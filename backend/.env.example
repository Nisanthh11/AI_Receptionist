# Copy to .env and replace every placeholder. Never commit the real .env file.

APP_NAME=AI Receptionist
ENVIRONMENT=development

# MySQL 8 (create the database first - see README). URL-encode special characters in the password.
DATABASE_URL=mysql+pymysql://DB_USER:DB_PASSWORD@localhost:3306/ai_receptionist?charset=utf8mb4

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"   (min 32 characters)
JWT_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# All appointment/visit times are stored as naive local times in this timezone
TIMEZONE=Asia/Kolkata
SLOT_MINUTES=30
MIN_BOOKING_LEAD_MINUTES=30
MAX_BOOKING_DAYS_AHEAD=60

# Used only by `python -m app.seed` to create the first admin account (never hardcoded)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-before-seeding
SEED_ADMIN_NAME=System Administrator
# Optional: also create a receptionist account when seeding
SEED_RECEPTIONIST_EMAIL=
SEED_RECEPTIONIST_PASSWORD=

# Optional: Email Notifications (SMTP)
# Leave SMTP_HOST empty for development mode (no external emails sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=reception@example.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10

# Optional: SMS Notifications
# Options: auto, twilio, generic_http, none
# Leave credentials empty for development mode (no external SMS sent).
SMS_PROVIDER=auto
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_GATEWAY_URL=
SMS_API_KEY=
SMS_SENDER_ID=RECEPTION

# Real Incoming Telephone Calls (Twilio Voice / SIP Telephony)
# Set your public webhook URL (e.g. from ngrok or cloud host): https://<your-domain>/api/telephony/incoming
TELEPHONY_PROVIDER=twilio
TELEPHONY_PHONE_NUMBER=
TELEPHONY_WEBHOOK_URL=
TELEPHONY_RECEPTION_TRANSFER_NUMBER=
TELEPHONY_VOICE=Polly.Joanna
TELEPHONY_LANGUAGE=en-US
TWILIO_VALIDATE_SIGNATURE=false

# VoiceLink India Telephony WebSocket Integration (Phase 3 & 3.1)
# Shared secret used to authenticate incoming WebSocket connections.
# Passed via query param (?token=<secret>) or header (X-VoiceLink-Secret or Authorization: Bearer <secret>).
VOICELINK_WEBHOOK_SECRET=

# Production Speech Services for VoiceLink (Phase 4)
# Options: STT_PROVIDER=mock or groq (free Whisper transcription via Groq Cloud)
STT_PROVIDER=mock
GROQ_API_KEY=

# Options: TTS_PROVIDER=mock or deepgram (conversational 8kHz speech via Deepgram Aura)
TTS_PROVIDER=mock
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=aura-asteria-en
VOICELINK_VAD_SILENCE_THRESHOLD=300.0
VOICELINK_VAD_SILENCE_FRAMES=35
VOICELINK_PACING_DELAY_MS=0.0

# Google Gemini AI Integration (Phase 4)
# Obtain a free API key from Google AI Studio: https://aistudio.google.com/
# Set GEMINI_ENABLED=true and supply GEMINI_API_KEY to activate Gemini hybrid NLU.
# If disabled or unconfigured, the system automatically runs the built-in rule-based responder.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=10
GEMINI_MAX_RETRIES=2
GEMINI_MAX_OUTPUT_TOKENS=800

